{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.forestrie/verify",
  "title": "Verify SCITT receipts from Forestrie transparency logs, offline",
  "description": "Verify a SCITT receipt under a trust root you hold — offline, no backend, no key, no network",
  "version": "0.5.0",
  "repository": {
    "url": "https://github.com/forestrie/mcp-verify",
    "source": "github"
  },
  "websiteUrl": "https://github.com/forestrie/mcp-verify#readme",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@forestrie/mcp-verify",
      "version": "0.5.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "-y",
          "isRequired": true
        }
      ]
    }
  ]
}
